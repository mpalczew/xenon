#!/usr/bin/env bash
set -euo pipefail

APP_DIR="${XENON_APP_DIR:-$HOME/.local/share/xenon}"
APP="$APP_DIR/xenon-bin"
DATA_DIR="$HOME/.xenon"

# Task terminals run this as `bash -c`, the session leader; its exit HUPs the
# app it backgrounded. An ignored HUP survives fork/exec, so set it up front.
trap '' HUP
# Closing a Xenon terminal SIGTERMs its shell's process group, and a background
# job of a non-interactive shell stays in that group. Start the app in its own
# session so closing a terminal that ran this leaves the window alive.
# `setsid` execs in place (the job is no group leader), so $! stays the app pid.
DETACH=()
if command -v setsid >/dev/null 2>&1; then
    DETACH=(setsid)
fi

usage() {
    cat >&2 <<'EOF'
usage: xenon [status | pair | quit [--end] | open [--workspace name|path|id] path[:line[:col]|:start-end] | path...]

xenon pair prints a phone pairing code and QR for the running Xenon.

xenon quit closes the running window; terminals keep running. xenon quit --end also ends
every terminal, of every build.

xenon open, run in a Xenon terminal, opens the file in that terminal's workspace
(XENON_WORKSPACE). --workspace picks another open workspace by name or root path.

With no args: focus the running window, or start one.
With path args (dirs and/or files): open them in the running window, or start one.

Each terminal runs in its own holder process (a systemd user unit), so closing the
window leaves every shell and agent running; the next `xenon` shows them again.
EOF
}

ui_pid() {
    local pid
    pid="$(tr -d '[:space:]' <"$DATA_DIR/xenon.pid" 2>/dev/null || true)"
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    printf '%s\n' "$pid"
}

active() {
    if systemctl --user is-active --quiet "$1" 2>/dev/null; then echo active; else echo inactive; fi
}

status() {
    local pid
    if pid="$(ui_pid)"; then
        echo "window: pid $pid"
    else
        echo "window: not running"
    fi
    echo "xenon-phone.service: $(active xenon-phone.service)"
    echo "terminals: $(systemctl --user list-units --plain --no-legend 'xenon-term-*.service' 2>/dev/null | wc -l)"
}

resolve_path_args() {
    local arg
    for arg in "$@"; do
        case "$arg" in
            /*) printf '%s\n' "$arg" ;;
            ~/*) printf '%s\n' "${arg/#\~/$HOME}" ;;
            *) printf '%s\n' "$(pwd)/$arg" ;;
        esac
    done
}

# Start the app; it hands off to a running window by itself and then exits.
launch() {
    mkdir -p "$DATA_DIR"
    ${DETACH[@]+"${DETACH[@]}"} "$APP" "$@" </dev/null >>"$DATA_DIR/xenon.log" 2>&1 &
    disown "$!" 2>/dev/null || true
}

main() {
    ulimit -c unlimited 2>/dev/null || true
    case "${1:-}" in
        status) status; exit 0 ;;
        -h | --help | help) usage; exit 0 ;;
    esac
    if [[ ! -x "$APP" ]]; then
        echo "Xenon app binary not found: $APP" >&2
        exit 1
    fi
    case "${1:-}" in
        "") launch ;;
        open | pair | quit) exec "$APP" "$@" ;;
        *)
            local args=() line
            while IFS= read -r line; do
                [[ -n "$line" ]] && args+=("$line")
            done < <(resolve_path_args "$@")
            launch "${args[@]}"
            ;;
    esac
}

main "$@"
