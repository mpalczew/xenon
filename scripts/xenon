#!/usr/bin/env bash
set -euo pipefail

# Slot launcher for Xenon.
# Linux has no .app bundle: scripts/release/install-linux puts the GUI binary
# at $XENON_APP_DIR/xenon-bin (default ~/.local/share/xenon).
if [[ "$(uname -s)" == Darwin ]]; then
    APP_BIN="${XENON_APP:-$HOME/Applications/Xenon.app}/Contents/MacOS/xenon"
else
    APP_BIN="${XENON_APP_DIR:-$HOME/.local/share/xenon}/xenon-bin"
fi
APP="$APP_BIN"
ACTIVE_FILE="$HOME/.xenon-active-slot"
# State both slots must see (phone-remote paired devices): not copied per slot.
SHARED_DIR="$HOME/.xenon-shared"

usage() {
    cat >&2 <<'EOF'
usage: xenon [status | open [--pane sibling|focused|split-right] path[:line[:col]|:start-end] | path...]

With no args:
  - 0 running: launch the last active slot (default a)
  - 1 running: copy its state to the other slot and launch the other slot
  - 2+ running: focus the last-launched slot (no new process)

With path args (dirs and/or files) — does NOT flip slots:
  - 0 running: launch last active slot and open paths
  - 1 running: hand off to that instance (single-instance IPC)
  - 2+ running: hand off to the last active slot's instance

  xenon <dir>   open / focus workspace
  xenon <file>  open file (switch workspace if the file belongs to one)
EOF
}

slot_dir() {
    case "$1" in
        a)
            printf '%s/.xenon-a\n' "$HOME"
            ;;
        b)
            printf '%s/.xenon-b\n' "$HOME"
            ;;
        *) return 1 ;;
    esac
}

other_slot() {
    case "$1" in
        a) printf 'b\n' ;;
        b) printf 'a\n' ;;
        *) return 1 ;;
    esac
}

pid_is_live_app() {
    local pid="$1"
    kill -0 "$pid" 2>/dev/null || return 1
    local comm
    comm="$(ps -p "$pid" -o comm= 2>/dev/null || true)"
    comm="${comm##*/}"
    # Dock stub execs xenon-bin; comm is the GUI name, not CFBundleExecutable.
    [[ "$comm" == "xenon" || "$comm" == "xenon-bin" ]]
}

# Linux: the slot comes from the process env in /proc.
pid_slot_linux() {
    local pid="$1" env slot data
    env="$(tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null)" || return 1
    slot="$(sed -n -e 's/^XENON_SLOT=//p' <<<"$env" | head -n1)"
    slot="$(printf '%s' "$slot" | tr '[:upper:]' '[:lower:]')"
    case "$slot" in
        a | b) printf '%s\n' "$slot"; return 0 ;;
    esac
    data="$(sed -n -e 's/^XENON_DATA_DIR=//p' <<<"$env" | head -n1)"
    data="${data%/}"
    case "$data" in
        *.xenon-a) printf 'a\n' ;;
        *.xenon-b) printf 'b\n' ;;
        *) return 1 ;;
    esac
}

# macOS does not expose process env via `ps e`; read it with KERN_PROCARGS2.
pid_slot() {
    local pid="$1"
    local slot
    if [[ "$(uname -s)" != Darwin ]]; then
        pid_slot_linux "$pid"
        return
    fi
    slot="$(
        python3 - "$pid" <<'PY'
import sys
import ctypes
import ctypes.util

pid = int(sys.argv[1])
libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)
# CTL_KERN=1, KERN_PROCARGS2=49
mib = (ctypes.c_int * 3)(1, 49, pid)
buf = ctypes.create_string_buffer(256 * 1024)
size = ctypes.c_size_t(len(buf))
if libc.sysctl(mib, 3, buf, ctypes.byref(size), None, 0) != 0:
    sys.exit(1)
parts = bytes(buf[: size.value]).split(b"\0")
env = {}
for part in parts:
    if b"=" not in part:
        continue
    key, _, val = part.partition(b"=")
    try:
        env[key.decode()] = val.decode()
    except UnicodeDecodeError:
        pass

slot = env.get("XENON_SLOT", "").strip().lower()
if slot in ("a", "b"):
    print(slot)
    sys.exit(0)

data = env.get("XENON_DATA_DIR", "").rstrip("/")
for suffix, out in (
    ("/.xenon-a", "a"),
    (".xenon-a", "a"),
    ("/.xenon-b", "b"),
    (".xenon-b", "b"),
):
    if data.endswith(suffix):
        print(out)
        sys.exit(0)
sys.exit(1)
PY
    )" || return 1
    printf '%s\n' "$slot"
}

# Live-instance files: never transfer; ditto also fails on Unix sockets.
RUNTIME_EXCLUDES=(
    --exclude='xenon.pid'
    --exclude='ipc.sock'
    --exclude='xenon.log'
)

# Drop any residual runtime files after a copy.
strip_runtime_files() {
    local dir="$1"
    [[ -n "$dir" && -d "$dir" ]] || return 0
    rm -f "$dir/xenon.pid" "$dir/ipc.sock" "$dir/xenon.log"
}

# Copy durable slot state only. Skips sockets/pidfiles/logs (ditto cannot copy sockets).
copy_state_dir() {
    local src="$1"
    local dst="$2"
    rm -rf "$dst"
    mkdir -p "$dst"
    rsync -a "${RUNTIME_EXCLUDES[@]}" "$src/" "$dst/"
    strip_runtime_files "$dst"
}

# Print "slot pid" lines for every live instance, prefer pidfiles then pgrep.
# Pidfiles are only trusted when the process's real slot (env) matches.
running_instances() {
    local slot pid seen="" pf claimed
    for slot in a b; do
        pf="$(slot_dir "$slot")/xenon.pid"
        [[ -f "$pf" ]] || continue
        pid="$(tr -d '[:space:]' <"$pf" 2>/dev/null || true)"
        if [[ ! "$pid" =~ ^[0-9]+$ ]]; then
            rm -f "$pf"
            continue
        fi
        if ! pid_is_live_app "$pid"; then
            rm -f "$pf"
            continue
        fi
        # Slot-aware: a copied/stale pidfile must not mint a second instance.
        if claimed="$(pid_slot "$pid" 2>/dev/null)" && [[ "$claimed" == "$slot" ]]; then
            printf '%s %s\n' "$slot" "$pid"
            seen+=" $pid "
        else
            rm -f "$pf"
        fi
    done

    # BSD pgrep hides its own ancestors (e.g. the Xenon hosting this shell)
    # unless -a; procps -a means something else and hides nothing.
    local pids ancestors=()
    [[ "$(uname -s)" == Darwin ]] && ancestors=(-a)
    pids="$(
        pgrep "${ancestors[@]}" -x xenon 2>/dev/null || true
        pgrep "${ancestors[@]}" -x xenon-bin 2>/dev/null || true
    )"
    [[ -n "$pids" ]] || return 0
    while IFS= read -r pid; do
        [[ -z "$pid" ]] && continue
        [[ "$seen" == *" $pid "* ]] && continue
        pid_is_live_app "$pid" || continue
        if slot="$(pid_slot "$pid" 2>/dev/null)"; then
            printf '%s %s\n' "$slot" "$pid"
            printf '%s\n' "$pid" >"$(slot_dir "$slot")/xenon.pid"
            seen+=" $pid "
        else
            printf '? %s\n' "$pid"
            seen+=" $pid "
        fi
    done <<<"$pids"
}

status() {
    local lines line slot pid any=false
    lines="$(running_instances)"
    if [[ -z "$lines" ]]; then
        echo "no Xenon instances running"
        return
    fi
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        any=true
        slot="${line%% *}"
        pid="${line##* }"
        echo "pid $pid slot $slot"
    done <<<"$lines"
    "$any"
}

last_slot() {
    local slot
    if [[ -f "$ACTIVE_FILE" ]]; then
        slot="$(tr -d '[:space:]' <"$ACTIVE_FILE")"
        case "$slot" in
            a|b) printf '%s\n' "$slot"; return ;;
        esac
    fi
    printf 'a\n'
}

copy_state() {
    local from="$1"
    local to="$2"
    local src dst
    src="$(slot_dir "$from")"
    dst="$(slot_dir "$to")"
    if [[ ! -d "$src" ]]; then
        echo "cannot copy: source state missing: $src" >&2
        exit 1
    fi
    copy_state_dir "$src" "$dst"
}

slot_data_dir() {
    local slot="$1"
    case "$slot" in
        a) printf '%s/.xenon-a\n' "$HOME" ;;
        b) printf '%s/.xenon-b\n' "$HOME" ;;
        *) return 1 ;;
    esac
}

# Run the app for `slot` with optional path args. Backgrounds the GUI process.
# Path handoff to a live instance exits quickly; cold start keeps running.
launch_slot() {
    local slot="$1"
    shift
    local dir upper log pid
    dir="$(slot_data_dir "$slot")"
    upper="$(printf '%s' "$slot" | tr '[:lower:]' '[:upper:]')"
    mkdir -p "$dir"
    log="$dir/xenon.log"
    printf '%s\n' "$slot" >"$HOME/.xenon-active-slot"
    XENON_DATA_DIR="$dir" XENON_SLOT="$upper" XENON_SHARED_DIR="$SHARED_DIR" \
        "$APP" "$@" >>"$log" 2>&1 &
    pid=$!
    printf '%s\n' "$pid" >"$dir/xenon.pid"
    disown "$pid" 2>/dev/null || true
    if [[ $# -gt 0 ]]; then
        echo "Xenon slot $slot ← $* (pid $pid)"
    else
        echo "launched Xenon slot $slot using $dir (pid $pid)"
    fi
}

# Which of the running a/b slots was launched second (last written to ACTIVE_FILE).
# Falls back to any running a/b slot if the marker is missing or stale.
second_slot() {
    local lines prefer line slot
    lines="$(running_instances)"
    prefer="$(last_slot)"
    if printf '%s\n' "$lines" | sed '/^$/d' | awk '{print $1}' | grep -qx "$prefer"; then
        printf '%s\n' "$prefer"
        return
    fi
    # Marker not among live a/b — pick the first a/b instance.
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        slot="${line%% *}"
        case "$slot" in
            a | b)
                printf '%s\n' "$slot"
                return
                ;;
        esac
    done <<<"$lines"
    return 1
}

# PID of a live a/b slot instance, if any.
pid_for_slot() {
    local want="$1" line slot pid
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        slot="${line%% *}"
        pid="${line##* }"
        if [[ "$slot" == "$want" && "$pid" =~ ^[0-9]+$ ]]; then
            printf '%s\n' "$pid"
            return 0
        fi
    done <<<"$(running_instances)"
    return 1
}

# Raise a process by unix pid (fallback when IPC handoff is unavailable).
raise_pid() {
    local pid="$1"
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    # Linux: no portable raise-by-pid (Wayland); the IPC Activate handoff is the path.
    [[ "$(uname -s)" == Darwin ]] || return 1
    osascript -e "tell application \"System Events\" to set frontmost of first process whose unix id is $pid to true" 2>/dev/null
}

# Focus a live slot: mark it active and IPC-Activate via a short-lived app spawn.
activate_slot() {
    local slot="$1"
    local dir upper log handoff live i
    case "$slot" in
        a | b) ;;
        *)
            echo "cannot activate unknown slot: $slot" >&2
            return 1
            ;;
    esac
    live="$(pid_for_slot "$slot" || true)"
    dir="$(slot_data_dir "$slot")"
    upper="$(printf '%s' "$slot" | tr '[:lower:]' '[:upper:]')"
    mkdir -p "$dir"
    log="$dir/xenon.log"
    printf '%s\n' "$slot" >"$HOME/.xenon-active-slot"
    # Empty argv → try_handoff(Activate) then exit. Bound wait so a failed handoff
    # cannot leave a third long-lived primary in the foreground of this shell.
    XENON_DATA_DIR="$dir" XENON_SLOT="$upper" XENON_SHARED_DIR="$SHARED_DIR" \
        "$APP" >>"$log" 2>&1 &
    handoff=$!
    i=0
    while kill -0 "$handoff" 2>/dev/null && ((i < 25)); do
        sleep 0.1
        i=$((i + 1))
    done
    if kill -0 "$handoff" 2>/dev/null; then
        # Still alive: treat as failed handoff, drop the extra process, raise live.
        kill "$handoff" 2>/dev/null || true
        wait "$handoff" 2>/dev/null || true
        if [[ -n "$live" ]] && raise_pid "$live"; then
            echo "focused Xenon slot $slot (pid $live)"
            return 0
        fi
        echo "could not focus Xenon slot $slot" >&2
        return 1
    fi
    wait "$handoff" 2>/dev/null || true
    # Handoff process exited; also nudge via System Events if we know the pid.
    if [[ -n "$live" ]]; then
        raise_pid "$live" 2>/dev/null || true
    fi
    echo "focused Xenon slot $slot"
}

# Pick which slot should receive path opens (never flips).
target_slot_for_paths() {
    local lines count line running
    lines="$(running_instances)"
    count="$(printf '%s\n' "$lines" | sed '/^$/d' | wc -l | tr -d ' ')"
    case "$count" in
        0)
            last_slot
            ;;
        1)
            line="$(printf '%s\n' "$lines" | sed '/^$/d' | head -n1)"
            running="${line%% *}"
            case "$running" in
                a | b) printf '%s\n' "$running" ;;
                *) last_slot ;;
            esac
            ;;
        *)
            # Prefer last active if it is among the running set.
            local prefer
            prefer="$(last_slot)"
            if printf '%s\n' "$lines" | sed '/^$/d' | awk '{print $1}' | grep -qx "$prefer"; then
                printf '%s\n' "$prefer"
            else
                line="$(printf '%s\n' "$lines" | sed '/^$/d' | head -n1)"
                printf '%s\n' "${line%% *}"
            fi
            ;;
    esac
}

# Resolve relative path args against the caller's cwd (app also canonicalizes).
resolve_path_args() {
    local arg abs
    for arg in "$@"; do
        case "$arg" in
            /*) printf '%s\n' "$arg" ;;
            ~/*) printf '%s\n' "${arg/#\~/$HOME}" ;;
            *) printf '%s\n' "$(pwd)/$arg" ;;
        esac
    done
}

open_paths() {
    local slot abs_args=()
    local line
    while IFS= read -r line; do
        [[ -n "$line" ]] && abs_args+=("$line")
    done < <(resolve_path_args "$@")
    slot="$(target_slot_for_paths)"
    case "$slot" in
        a | b) ;;
        *)
            echo "cannot resolve slot for path open" >&2
            status >&2
            exit 1
            ;;
    esac
    # Single-instance IPC lives in the app; this just targets the right data dir.
    launch_slot "$slot" "${abs_args[@]}"
}

main() {
    if [[ ! -x "$APP" ]]; then
        echo "Xenon app binary not found: $APP" >&2
        exit 1
    fi
    case "${1:-}" in
        "") ;;
        status) status; exit 0 ;;
        -h | --help | help) usage; exit 0 ;;
        open)
            # Never flip A/B. Honor XENON_DATA_DIR from a Xenon PTY so the
            # parent instance gets the file even when another slot is last-active.
            if [[ -z "${XENON_DATA_DIR:-}" ]]; then
                slot="$(target_slot_for_paths)"
                case "$slot" in
                    a | b) ;;
                    *)
                        echo "cannot resolve slot for xenon open" >&2
                        status >&2
                        exit 1
                        ;;
                esac
                dir="$(slot_data_dir "$slot")"
                upper="$(printf '%s' "$slot" | tr '[:lower:]' '[:upper:]')"
                export XENON_DATA_DIR="$dir" XENON_SLOT="$upper" XENON_SHARED_DIR="$SHARED_DIR"
            fi
            exec "$APP" "$@"
            ;;
        *)
            # Path / open mode — never flip A/B.
            open_paths "$@"
            exit 0
            ;;
    esac

    local lines count running slot line
    lines="$(running_instances)"
    count="$(printf '%s\n' "$lines" | sed '/^$/d' | wc -l | tr -d ' ')"

    case "$count" in
        0)
            slot="$(last_slot)"
            launch_slot "$slot"
            ;;
        1)
            line="$(printf '%s\n' "$lines" | sed '/^$/d' | head -n1)"
            running="${line%% *}"
            case "$running" in
                a | b)
                    # Count is already slot-aware; no second pidfile probe.
                    slot="$(other_slot "$running")"
                    copy_state "$running" "$slot"
                    launch_slot "$slot"
                    ;;
                *)
                    echo "one instance is running, but its slot is unknown:" >&2
                    status >&2
                    exit 1
                    ;;
            esac
            ;;
        *)
            # Both slots already up: bring the last-launched (second) to front.
            if slot="$(second_slot)"; then
                activate_slot "$slot"
            else
                echo "two or more Xenon instances are running, but no a/b slot is known:" >&2
                status >&2
                exit 1
            fi
            ;;
    esac
}

main "$@"
