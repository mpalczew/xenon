#!/usr/bin/env -S python3 -I
"""Agent-verifiability check for the GTK frontend.

usage: scripts/xenon-gtk-verify [path/to/xenon_gtk] [screenshot_dir]

Drives a real xenon_gtk window the way an agent would, with no synthetic mouse:
  - D-Bus actions (org.gtk.Actions) for commands, and the `ui-state` action's
    state for what the app says is on screen (workspaces, panes, tabs, status);
  - AT-SPI (pyatspi) to read terminal text back out of the window;
  - `screenshot` action for offscreen PNGs of each state.
It covers: create workspaces, split, new tab, keyboard-action navigation, type
into a terminal and read the output, working pulse, attention dot, find,
Settings (Ctrl+, opens it; font size and theme change the live terminal and
persist across a restart; a screenshot of every page and the theme picker,
dark and light), and save + restore of the session.
VERIFY_ONLY_SETTINGS=1 runs just the Settings part. State lives in a private temp dir (never
~/.xenon-gtk) and the app runs under its own app id. Only the process it
started is closed, by PID. Set GDK_BACKEND=x11 on a locked Wayland session
(a locked compositor sends no frame callbacks, so nothing would lay out).

Exit code 0 when every check passes.
"""
import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import time

import gi
import pyatspi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
BINARY = sys.argv[1] if len(sys.argv) > 1 else f"{ROOT}/target/dogfood/xenon_gtk"
SHOTS = sys.argv[2] if len(sys.argv) > 2 else "/tmp/xenon-gtk-shots"
APP_ID = f"dev.xenon.GtkVerify{os.getpid()}"
os.makedirs(SHOTS, exist_ok=True)
failures = []


def check(ok, what):
    print(("PASS: " if ok else "FAIL: ") + what)
    if not ok:
        failures.append(what)


def pump():
    """D-Bus action state changes arrive through the GLib main loop."""
    ctx = GLib.MainContext.default()
    while ctx.pending():
        ctx.iteration(False)


def wait_for(fn, what, timeout=20.0):
    end = time.monotonic() + timeout
    while time.monotonic() < end:
        pump()
        v = fn()
        if v:
            return v
        time.sleep(0.15)
    check(False, f"timed out waiting for {what}")
    raise SystemExit(finish())


def finish():
    print(f"{len(failures)} failure(s)" if failures else "all checks passed")
    return 1 if failures else 0


def find(acc, pred):
    if pred(acc):
        return acc
    for i in range(acc.childCount):
        try:
            r = find(acc.getChildAtIndex(i), pred)
        except Exception:
            continue
        if r:
            return r
    return None


def find_all(acc, pred, out):
    try:
        if pred(acc):
            out.append(acc)
        count = acc.childCount
    except Exception:
        return out
    for i in range(count):
        try:
            find_all(acc.getChildAtIndex(i), pred, out)
        except Exception:
            continue
    return out


class App:
    """One running xenon_gtk under a private state dir."""

    def __init__(self, state_dir):
        self.state_dir = state_dir
        self.proc = subprocess.Popen(
            [BINARY],
            env={**os.environ, "XENON_GTK_APP_ID": APP_ID, "XENON_GTK_DATA_DIR": state_dir},
            stdout=subprocess.DEVNULL,
            stderr=open(os.path.join(state_dir, "..", "app.log"), "w"),
            start_new_session=True,
        )
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.group = Gio.DBusActionGroup.get(self.bus, APP_ID, "/" + APP_ID.replace(".", "/"))
        wait_for(lambda: "ui-state" in (self.group.list_actions() or []), "app actions on D-Bus")
        wait_for(lambda: self.group.get_action_state("ui-state") is not None, "ui-state")
        self.ax = None
        end = time.monotonic() + 8
        while time.monotonic() < end and not self.ax:
            self.ax = self._find_ax_app()
            time.sleep(0.2)
        if not self.ax:
            print("note: no accessibility bridge on this display; reading terminal text with the dump-screen action")
        self.dump = os.path.join(state_dir, "..", "screen.txt")

    def _find_ax_app(self):
        desk = pyatspi.Registry.getDesktop(0)
        for i in range(desk.childCount):
            a = desk.getChildAtIndex(i)
            try:
                if a and a.get_process_id() == self.proc.pid:
                    return a
            except Exception:
                pass
        return None

    def act(self, name, arg=None):
        self.group.activate_action(name, GLib.Variant("s", arg) if arg is not None else None)
        self.bus.flush_sync(None)

    def state(self):
        pump()
        v = self.group.get_action_state("ui-state")
        return json.loads(v.get_string()) if v else {}

    def until(self, pred, what, timeout=15.0):
        try:
            return wait_for(lambda: pred(self.state()) and self.state(), what, timeout)
        except SystemExit:
            print("last ui-state:", json.dumps(self.state()))
            raise

    def pstate(self, name):
        pump()
        v = self.group.get_action_state(name)
        return json.loads(v.get_string()) if v and v.get_string() else {}

    def palette(self):
        return self.pstate("palette-state")

    def files(self):
        return self.pstate("files-state")

    def terminals(self):
        shown = lambda a: a.getRoleName() == "terminal" and a.getState().contains(pyatspi.STATE_SHOWING)
        return find_all(self.ax, shown, [])

    def has_terminal(self):
        return bool(self.terminals()) if self.ax else bool(self.state().get("panes"))

    def screen_text(self):
        if self.ax:
            return "\n".join(t.queryText().getText(0, -1) for t in self.terminals())
        if os.path.exists(self.dump):
            os.remove(self.dump)
        self.act("dump-screen", self.dump)
        end = time.monotonic() + 3
        while time.monotonic() < end and not os.path.exists(self.dump):
            pump()
            time.sleep(0.05)
        time.sleep(0.05)
        return open(self.dump).read() if os.path.exists(self.dump) else ""

    def type(self, text):
        self.act("feed-child", text)

    def shot(self, name):
        path = f"{SHOTS}/{name}.png"
        if os.path.exists(path):
            os.remove(path)
        self.act("screenshot", path)
        wait_for(lambda: os.path.exists(path) and os.path.getsize(path) > 0, f"screenshot {name}")
        print("screenshot:", path)

    def stop(self):
        self.act("quit")
        try:
            self.proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            self.proc.terminate()
            self.proc.wait(timeout=10)

    def kill(self):
        if self.proc.poll() is None:
            self.proc.send_signal(signal.SIGTERM)
            self.proc.wait(timeout=10)


SETTINGS_PAGES = ["appearance", "fonts", "editor", "terminal", "agents", "servers"]


def sget(app):
    pump()
    v = app.group.get_action_state("settings-state")
    return json.loads(v.get_string()) if v and v.get_string() else {}


def swait(app, pred, what, timeout=10.0):
    return wait_for(lambda: (lambda s: s if pred(s) else None)(sget(app)), what, timeout)


def sset(app, key, value):
    app.act("settings-set", f"{key}={value}")


def read_settings(state_dir):
    try:
        return json.load(open(os.path.join(state_dir, "settings.json")))
    except (OSError, ValueError):
        return {}


def settings_checks(app, state_dir):
    """Ctrl+, opens Settings; changes apply live and persist."""
    base = sget(app)
    check(base.get("open") is False, "Settings starts closed")
    app.act("focus-terminal")
    swait(app, lambda s: s["focus"] == "terminal", "terminal focused before Settings")
    app.act("send-key", "ctrl-,")
    s = swait(app, lambda s: s["open"], "Ctrl+, opens Settings")
    check(s["page"] == "appearance", "Settings opens on Appearance")

    # Font size: the live terminal and the settings file both follow.
    app.act("settings-page", "fonts")
    swait(app, lambda s: s["page"] == "fonts", "fonts page")
    before = sget(app)["term_font"]
    sset(app, "size-terminal", 19)
    s = swait(app, lambda s: s["term_font"] != before and "19px" in (s["term_font"] or ""), "terminal font follows the size row")
    check(True, f"terminal font became {s['term_font']!r} live")
    wait_for(lambda: read_settings(state_dir).get("terminal_font_size") == 19, "terminal size saved")
    check(True, "the new terminal size was saved to settings.json")
    sset(app, "size-terminal", 99)
    swait(app, lambda s: s["terminal_size"] == 32, "size clamps to the maximum")
    check(True, "a size above the range clamps to 32 like the GPUI app")
    sset(app, "size-terminal", 19)
    swait(app, lambda s: s["terminal_size"] == 19, "size back to 19")
    sset(app, "size-ui", 16)
    wait_for(lambda: read_settings(state_dir).get("ui_font_size") == 16, "interface size saved")
    check(True, "the interface size was saved")

    # Theme: mode flips the whole window, the picker previews before keeping.
    sset(app, "mode", "dark")
    s = swait(app, lambda s: s["mode"] == "Dark" and s["dark"], "dark mode")
    dark_bg = s["term_bg"]
    for page in SETTINGS_PAGES:
        app.act("settings-page", page)
        swait(app, lambda s, p=page: s["page"] == p, f"{page} page")
        app.shot(f"settings-dark-{page}")
    app.act("settings-page", "appearance")
    swait(app, lambda s: s["page"] == "appearance", "appearance page")
    app.act("settings-set", "picker-open=1")
    time.sleep(0.6)
    app.shot("settings-dark-picker")
    app.act("settings-set", "picker-select=Nord:dark")
    s = swait(app, lambda s: s["preview"] == "Nord", "picker previews Nord")
    check(s["term_bg"] != dark_bg, "previewing Nord changed the live terminal colors")
    check(read_settings(state_dir).get("dark_theme") != "Nord", "a preview is not saved")
    app.shot("settings-dark-picker-preview")
    app.act("settings-set", "picker-revert=1")
    s = swait(app, lambda s: s["preview"] is None and s["term_bg"] == dark_bg, "revert restores the theme")
    check(True, "Revert put the saved theme back")
    app.act("settings-set", "picker-open=1")
    time.sleep(0.4)
    app.act("settings-set", "picker-select=Gruvbox:dark")
    swait(app, lambda s: s["preview"] == "Gruvbox Dark", "picker previews Gruvbox")
    app.act("settings-set", "picker-keep=1")
    s = swait(app, lambda s: s["preview"] is None and s["dark_theme"] == "Gruvbox Dark", "keep stores Gruvbox")
    wait_for(lambda: read_settings(state_dir).get("dark_theme") == "Gruvbox Dark", "theme saved")
    check(s["term_bg"] != dark_bg, "Keep changed the terminal colors for good")
    check(True, "Keep saved Gruvbox Dark in the dark slot")
    sset(app, "mode", "light")
    s = swait(app, lambda s: s["mode"] == "Light" and not s["dark"], "light mode")
    for page in SETTINGS_PAGES:
        app.act("settings-page", page)
        swait(app, lambda s, p=page: s["page"] == p, f"{page} page (light)")
        app.shot(f"settings-light-{page}")
    app.act("settings-page", "appearance")
    app.act("settings-set", "picker-open=1")
    time.sleep(0.6)
    app.shot("settings-light-picker")
    app.act("settings-set", "picker-revert=1")
    swait(app, lambda s: s["preview"] is None, "picker closed")
    sset(app, "mode", "dark")
    swait(app, lambda s: s["mode"] == "Dark" and s["dark"], "dark again")
    sset(app, "size-ui", 14)
    swait(app, lambda s: s["ui_size"] == 14, "interface size reset")

    # Ctrl+, again closes it and the cursor is back in the terminal.
    app.act("send-key", "ctrl-,")
    s = swait(app, lambda s: not s["open"], "Ctrl+, closes Settings")
    check(True, "Ctrl+, closed Settings")
    swait(app, lambda s: s["focus"] == "terminal", "focus returns to the terminal", 8)
    check(True, "focus returned to the terminal")
    # Closing from inside (what Escape does) also hands focus back.
    app.act("send-key", "ctrl-,")
    swait(app, lambda s: s["open"], "Settings reopened")
    time.sleep(0.7)  # let the open animation finish before closing it
    app.act("settings-set", "close=1")
    swait(app, lambda s: not s["open"] and s["focus"] == "terminal", "close from inside returns focus", 8)
    check(True, "closing from inside returned the cursor to the terminal")


def settings_restart_checks(app2):
    s = swait(app2, lambda s: s["terminal_size"] == 19 and s["dark_theme"] == "Gruvbox Dark", "settings restored")
    check(s["mode"] == "Dark" and "19px" in (s["term_font"] or ""), f"settings survived a restart (terminal font {s['term_font']!r}, {s['dark_theme']})")


def tabs(state):
    return [[t["label"] for t in p["tabs"]] for p in state.get("panes", [])]


def active_ws(state):
    return next((w["name"] for w in state["workspaces"] if w["active"]), None)


def main():
    tmp = tempfile.mkdtemp(prefix="xenon-gtk-verify-")
    state_dir = os.path.join(tmp, "state")
    os.makedirs(state_dir)
    # A registry file keeps the app from seeding itself out of the GPUI state.
    with open(os.path.join(state_dir, "workspaces.json"), "w") as f:
        json.dump({"version": 2, "workspaces": [], "closed_workspaces": [], "active": None}, f)
    ws_a, ws_b, ws_c = (os.path.join(tmp, n) for n in ("alpha", "beta", "gamma"))
    for d in (ws_a, ws_b, ws_c):
        os.makedirs(d)
    # A small project in beta for the Files section and the finder.
    os.makedirs(os.path.join(ws_b, "src", "deep"))
    for name, text in (
        ("README.md", "# beta\n"),
        ("Cargo.toml", "[package]\nname = \"beta\"\n"),
        ("src/main.rs", "fn main() {\n    println!(\"hi\");\n}\n"),
        ("src/lib.rs", "pub fn f() {}\n"),
        ("src/deep/mod.rs", "// deep\n"),
    ):
        with open(os.path.join(ws_b, name), "w") as f:
            f.write(text)
    app = App(state_dir)
    try:
        run(app, ws_a, ws_b, ws_c, state_dir)
    finally:
        app.kill()
        try:
            print(open(os.path.join(tmp, "app.log")).read()[-2000:])
        except OSError:
            pass
        shutil.rmtree(tmp, ignore_errors=True)
    return finish()


def run(app, ws_a, ws_b, ws_c, state_dir):
    # Workspaces.
    app.act("open-dir", ws_a)
    s = app.until(lambda s: active_ws(s) == "alpha" and [len(p) for p in tabs(s)] == [1], "alpha workspace with one terminal")
    check(True, "open-dir created workspace 'alpha' with one terminal")
    app.act("open-dir", ws_b)
    s = app.until(lambda s: active_ws(s) == "beta" and len(s["workspaces"]) == 2, "second workspace")
    check(True, "second workspace 'beta' created and active")
    app.shot("01-sidebar-two-workspaces")
    if os.environ.get("VERIFY_ONLY_SETTINGS"):
        app.until(lambda s: all(t["label"] != "terminal" for p in s["panes"] for t in p["tabs"]), "shell titled")
        wait_for(app.has_terminal, "terminal")
        settings_checks(app, state_dir)
        app.act("save-now")
        app.stop()
        app2 = App(state_dir)
        try:
            settings_restart_checks(app2)
        finally:
            app2.kill()
        return

    # Tab titles are short directory names, never "user@host:/path".
    s = app.until(lambda s: all(t["label"] != "terminal" for p in s["panes"] for t in p["tabs"]), "shell titled")
    labels = [t["label"] for p in s["panes"] for t in p["tabs"]]
    check(not any("@" in l or "/" in l for l in labels), f"tab labels are clean {labels}")
    check(s["panes"][0]["tabs"][0]["label"].split(" ")[0] in ("bash", "zsh", "fish", "sh", "shell"), "a plain prompt shows the shell name")

    # Files section: the tree of the active workspace, driven by keys.
    f = wait_for(lambda: (lambda f: f if [r["name"] for r in f.get("rows", [])][:2] == ["src", "Cargo.toml"] else None)(app.files()), "files tree rows")
    check([r["name"] for r in f["rows"]] == ["src", "Cargo.toml", "README.md"], f"files lists folders first, then names: {[r['name'] for r in f['rows']]}")
    app.act("focus-sidebar")
    f = wait_for(lambda: (lambda f: f if f.get("focused") else None)(app.files()), "files tree focused")
    check(f["selected"] == "src", "the keyboard lands in the tree on the first row")
    app.act("files-key", "right")
    f = wait_for(lambda: (lambda f: f if "main.rs" in [r["name"] for r in f["rows"]] else None)(app.files()), "src expanded")
    check([r["name"] for r in f["rows"] if r["depth"] == 1] == ["deep", "lib.rs", "main.rs"], "Right opens a folder and lists its entries")
    app.act("files-key", "down")  # deep
    app.act("files-key", "down")  # lib.rs
    app.act("files-key", "down")  # main.rs
    app.act("files-key", "enter")
    s = app.until(lambda s: any(t["label"] == "main.rs" for p in s["panes"] for t in p["tabs"]), "main.rs tab from the tree")
    check(True, "Enter on a file in the tree opened it in an editor tab")
    f = wait_for(lambda: (lambda f: f if any(r["open"] for r in f["rows"]) else None)(app.files()), "open file marked")
    check([r["name"] for r in f["rows"] if r["open"]] == ["main.rs"], "the tree marks the open file")
    app.shot("08-files-and-editor")
    app.act("files-key", "left")
    app.act("files-key", "left")
    f = wait_for(lambda: (lambda f: f if "main.rs" not in [r["name"] for r in f["rows"]] else None)(app.files()), "src collapsed")
    check(True, "Left steps out and closes a folder")

    # Ctrl+P: the finder, keyboard only.
    app.act("send-key", "ctrl-p")
    p = wait_for(lambda: (lambda p: p if p.get("open") and p.get("rows") else None)(app.palette()), "finder open with rows")
    check(p["entry_focused"], "Ctrl+P opened the finder with the cursor in its field")
    app.act("palette-text", "m")
    p = wait_for(lambda: (lambda p: p if p.get("count", 0) >= 2 and p["query"] == "m" and any("main.rs" in r for r in p["rows"]) else None)(app.palette()), "finder results for 'm'")
    app.shot("09-finder-results")
    first = p["selected"]
    app.act("send-key", "ctrl-n")
    p = wait_for(lambda: (lambda p: p if p["selected"] == first + 1 else None)(app.palette()), "Ctrl+N moves down")
    check(True, "Ctrl+N moved the selection down while the finder is open")
    app.act("send-key", "ctrl-p")
    p = wait_for(lambda: (lambda p: p if p["selected"] == first else None)(app.palette()), "Ctrl+P moves up")
    check(p["open"], "Ctrl+P moved the selection up (and did not close the finder)")
    app.act("palette-text", "lib.rs")
    p = wait_for(lambda: (lambda p: p if p["query"] == "lib.rs" and p.get("selected_title", "") and p["selected_title"].endswith("lib.rs") else None)(app.palette()), "lib.rs on top")
    check(p["selected_title"] == "src/lib.rs", "fuzzy query 'lib.rs' ranks src/lib.rs first")
    app.act("palette-key", "enter")
    s = app.until(lambda s: any(t["label"] == "lib.rs" for p in s["panes"] for t in p["tabs"]), "lib.rs tab from the finder")
    check(not app.palette()["open"], "Enter opened the file and closed the finder")
    app.act("send-key", "ctrl-p")
    wait_for(lambda: app.palette().get("open"), "finder reopens")
    app.act("palette-key", "escape")
    p = wait_for(lambda: (lambda p: p if not p["open"] else None)(app.palette()), "Escape closes the finder")
    check(True, "Escape closed the finder")
    # Focus returns to the editor that had it: typing there reaches the file.
    app.act("send-key", "ctrl-p")
    wait_for(lambda: app.palette().get("open"), "finder opens again")
    app.act("palette-key", "escape")
    wait_for(lambda: not app.palette().get("open"), "finder closed again")

    # Ctrl+Shift+O: the workspace picker with path completion.
    parent = os.path.dirname(ws_c)
    app.act("send-key", "ctrl-shift-o")
    p = wait_for(lambda: (lambda p: p if p.get("open") and any("alpha" in r for r in p.get("rows", [])) else None)(app.palette()), "workspace picker open")
    check(any("alpha" in r for r in p["rows"]) and any("beta" in r for r in p["rows"]), f"the picker lists open workspaces: {p['rows']}")
    app.shot("10a-workspace-picker-empty")
    app.act("palette-text", parent + "/gam")
    p = wait_for(lambda: (lambda p: p if p.get("rows") and p["rows"][0] == "gamma" else None)(app.palette()), "gamma completes from the typed path")
    app.shot("10-workspace-picker")
    app.act("palette-key", "tab")
    p = wait_for(lambda: (lambda p: p if p["query"].endswith("gamma/") else None)(app.palette()), "Tab completes the path")
    check(p["query"].replace(os.path.expanduser("~"), "~") .endswith("/gamma/"), "Tab completed the typed path to the folder")
    app.act("palette-text", parent + "/gam")
    wait_for(lambda: (lambda p: p.get("query") == parent + "/gam" and p.get("rows", [None])[:1] == ["gamma"])(app.palette()), "gamma again")
    app.act("palette-key", "enter")
    s = app.until(lambda s: active_ws(s) == "gamma" and len(s["workspaces"]) == 3, "gamma opened from the picker")
    check(not app.palette()["open"], "Enter opened the folder as a workspace and closed the picker")
    app.act("close-workspace")
    s = app.until(lambda s: len(s["workspaces"]) == 2, "gamma closed again")
    app.act("send-key", "ctrl-shift-o")
    wait_for(lambda: app.palette().get("open"), "picker with a closed workspace")
    app.act("palette-text", "gamma")
    p = wait_for(lambda: (lambda p: p if p.get("rows") and p["rows"][0] == "gamma" else None)(app.palette()), "closed workspace found by name")
    app.act("palette-key", "escape")
    app.act("focus-terminal")
    s = app.until(lambda s: active_ws(s) == "beta" or True, "back")
    if active_ws(app.state()) != "beta":
        app.act("next-workspace")
    app.until(lambda s: active_ws(s) == "beta", "beta active again")
    # Close the editor tabs again so the terminal checks below see terminals.
    for _ in range(2):
        app.act("close-tab")
    app.until(lambda s: all(t["label"] not in ("main.rs", "lib.rs") for p in s["panes"] for t in p["tabs"]), "editor tabs closed")
    app.act("focus-terminal")

    # Type into the terminal and read it back over AT-SPI.
    wait_for(app.has_terminal, "terminal")
    app.type("echo $((6*7))-verify-ok\n")
    wait_for(lambda: "42-verify-ok" in app.screen_text(), "typed command output in terminal text")
    check(True, "typed a command and read '42-verify-ok' back through AT-SPI")

    # Split, new tab, tab and pane navigation.
    app.act("split-right")
    s = app.until(lambda s: len(s["panes"]) == 2, "two panes after split-right")
    check(len(s["panes"]) == 2 and all(len(p) == 1 for p in tabs(s)), "split-right made two panes of one tab each")
    app.act("new-terminal")
    s = app.until(lambda s: sorted(len(p) for p in tabs(s)) == [1, 2], "new tab in the focused pane")
    check(True, "new-terminal added a second tab to the focused pane")
    pane = next(p for p in s["panes"] if len(p["tabs"]) == 2)
    before = pane["active"]
    app.act("prev-tab")
    s = app.until(lambda s: next(p for p in s["panes"] if len(p["tabs"]) == 2)["active"] != before, "prev-tab changes the active tab")
    check(True, "prev-tab moved the active tab")
    app.act("next-tab")
    app.until(lambda s: next(p for p in s["panes"] if len(p["tabs"]) == 2)["active"] == before, "next-tab returns")
    check(True, "next-tab moved it back")
    focused = s["focused_pane"]
    app.act("next-pane")
    s = app.until(lambda s: s["focused_pane"] != focused, "next-pane moves focus")
    check(True, "next-pane moved the focused pane")
    app.act("split-down")
    s = app.until(lambda s: len(s["panes"]) == 3, "three panes after split-down")
    check(True, "split-down made a third pane")
    app.type("echo split-pane-text\n")
    wait_for(lambda: "split-pane-text" in app.screen_text(), "typing in the new pane")
    app.shot("02-split-panes")

    # Workspace switching by action.
    app.act("prev-workspace")
    s = app.until(lambda s: active_ws(s) == "alpha", "prev-workspace goes to alpha")
    check(True, "prev-workspace switched to alpha")
    app.act("next-workspace")
    app.until(lambda s: active_ws(s) == "beta", "next-workspace back to beta")
    check(True, "next-workspace switched back to beta")
    app.act("focus-sidebar")
    app.shot("03-sidebar-focus")
    app.act("focus-terminal")

    # Key chords through GTK's own event path (send-key): the same shortcut
    # controllers a real key press reaches, with a terminal focused.
    total = lambda s: sum(len(p) for p in tabs(s))
    n0 = total(app.state())
    app.act("send-key", "ctrl-n")
    app.until(lambda s: total(s) == n0 + 1, "Ctrl+N adds a tab")
    check(True, "Ctrl+N opened a terminal tab")
    app.until(lambda s: all(t["label"] != "terminal" for p in s["panes"] for t in p["tabs"]), "new shell up")
    app.act("send-key", "ctrl-w")
    app.until(lambda s: total(s) == n0, "Ctrl+W closes the tab")
    check(True, "Ctrl+W closed the tab")
    focused = app.state()["focused_pane"]
    app.act("send-key", "ctrl-`")
    app.until(lambda s: s["focused_pane"] != focused, "Ctrl+` moves to the next pane")
    check(True, "Ctrl+` moved focus to the next pane")
    leaves = len(app.state()["panes"])
    app.act("send-key", "ctrl-\\")
    app.until(lambda s: len(s["panes"]) == leaves + 1, "Ctrl+\\ splits right")
    check(True, "Ctrl+\\ split the pane")
    app.act("send-key", "ctrl-alt-up")
    app.until(lambda s: active_ws(s) == "alpha", "Ctrl+Alt+Up goes to the previous workspace")
    app.act("send-key", "ctrl-alt-down")
    app.until(lambda s: active_ws(s) == "beta", "Ctrl+Alt+Down goes back")
    check(True, "Ctrl+Alt+Up / Down switched workspaces")
    # Keys the shell owns pass through: Ctrl+C interrupts a running command.
    app.type("sleep 30\n")
    time.sleep(0.8)
    app.act("send-key", "ctrl-c")
    wait_for(lambda: "^C" in app.screen_text(), "Ctrl+C reaches the shell")
    check(True, "Ctrl+C went to the terminal (interrupted 'sleep 30')")

    # Exit handling: a shell that exits closes its tab after the delay.
    n1 = total(app.state())
    app.act("new-terminal")
    app.until(lambda s: total(s) == n1 + 1 and all(t["label"] != "terminal" for p in s["panes"] for t in p["tabs"]), "tab for exit")
    app.type("exit\n")
    app.until(lambda s: total(s) == n1, "exited tab auto-closes", 20)
    check(True, "a shell that exited had its tab closed")

    # Closing a tab ends the shell under it: a leaked widget would keep it alive.
    marker = f"sleep {31000 + os.getpid() % 1000}"
    running = lambda: subprocess.run(["pgrep", "-f", marker], capture_output=True).returncode == 0
    app.act("new-terminal")
    app.until(lambda s: total(s) == n1 + 1 and all(t["label"] != "terminal" for p in s["panes"] for t in p["tabs"]), "tab for close")
    app.type(marker + "\n")
    wait_for(running, f"'{marker}' running")
    app.act("close-tab")
    wait_for(lambda: not running(), f"'{marker}' ended after its tab closed", 15)
    check(True, "closing a tab with a running command ended it")

    # Font zoom persists through the shared settings.
    def font_size():
        try:
            return json.load(open(os.path.join(state_dir, "settings.json"))).get("terminal_font_size")
        except (OSError, ValueError):
            return None

    base = font_size() or 14.0
    app.act("zoom-in")
    wait_for(lambda: font_size() == base + 1, "zoom-in written to settings")
    app.act("zoom-out")
    wait_for(lambda: font_size() == base, "zoom-out written to settings")
    check(True, "zoom in / out changed and saved the terminal font size")

    settings_checks(app, state_dir)

    # A folder link opens as a workspace (routing shared with `xenon open`).
    app.act("open-link", ws_c)
    app.until(lambda s: active_ws(s) == "gamma" and len(s["workspaces"]) == 3, "link opened gamma")
    check(True, "a folder link opened a new workspace")
    app.act("close-workspace")
    app.until(lambda s: len(s["workspaces"]) == 2 and active_ws(s) == "beta", "close-workspace")
    check(True, "close-workspace closed it and fell back to a neighbour")

    # Working pulse: a terminal titled like an agent that keeps drawing.
    app.act("new-terminal")
    # A new shell sets its title once it is up; input sent before that is lost.
    app.until(lambda s: all(t["label"] != "terminal" for p in s["panes"] for t in p["tabs"]) and sum(len(p) for p in tabs(s)) == 5, "new shell up")
    app.type("printf '\\033]0;claude\\007'; while :; do printf '.'; sleep 0.03; done\n")
    app.until(lambda s: any(t["dot"] == "working" for p in s["panes"] for t in p["tabs"]), "working status", 90)
    s = app.state()
    check(any(w["dot"] == "working" for w in s["workspaces"]), "workspace row shows the working pulse")
    app.act("prev-tab")  # leave the agent tab so its chip rail shows
    app.shot("04-working-pulse")
    app.act("next-tab")
    app.type("\x03")
    app.until(lambda s: not any(t["dot"] == "working" for p in s["panes"] for t in p["tabs"]), "working ends after Ctrl+C", 30)
    check(True, "working status ended when the agent stopped")

    # Attention dot: a bell in a tab the user is not looking at.
    app.type("(sleep 2; printf '\\a') &\n")
    app.act("prev-tab")
    s = app.until(lambda s: any(t["dot"] == "attention" for p in s["panes"] for t in p["tabs"]), "attention after bell", 30)
    check(True, "a bell in a hidden tab lit its attention dot")
    check(any(w["dot"] == "attention" for w in s["workspaces"]), "workspace row shows attention")
    app.shot("05-attention-dot")
    app.act("next-tab")  # viewing the tab clears its mark
    app.until(lambda s: not any(t["dot"] == "attention" for p in s["panes"] for t in p["tabs"]), "attention cleared on view", 10)
    check(True, "viewing the tab dismissed its attention mark")

    # Find.
    app.type("echo needle-in-haystack\n")
    wait_for(lambda: "needle-in-haystack" in app.screen_text(), "needle printed")
    app.act("find-query", "needle")
    time.sleep(0.8)
    app.shot("06-find")

    # Close a tab and a workspace.
    n_before = sum(len(p) for p in tabs(app.state()))
    app.act("close-tab")
    app.until(lambda s: sum(len(p) for p in tabs(s)) == n_before - 1, "close-tab removes a tab")
    check(True, "close-tab closed the active tab")

    # Save and restore.
    layout = tabs(app.state())
    app.act("save-now")
    app.stop()
    check(os.path.exists(os.path.join(state_dir, "workspaces.json")), "registry written")
    sessions = os.listdir(os.path.join(state_dir, "sessions"))
    check(len(sessions) == 3, f"a session file per workspace ({len(sessions)})")
    app2 = App(state_dir)
    try:
        s = app2.until(lambda s: len(s["workspaces"]) == 2 and len(s["panes"]) >= 1, "restored workspaces")
        check(active_ws(s) == "beta", "restore reopened the workspace that was active")
        check(tabs(s) == layout or [len(p) for p in tabs(s)] == [len(p) for p in layout], f"restored pane and tab layout {tabs(s)} == {layout}")
        wait_for(app2.has_terminal, "restored terminal")
        app2.type("echo $((7*7))-restored\n")
        wait_for(lambda: "49-restored" in app2.screen_text(), "typing in the restored terminal")
        check(True, "restored session has a live terminal (typed and read '49-restored')")
        settings_restart_checks(app2)
        app2.shot("07-restored")
    finally:
        app2.kill()


sys.exit(main())
