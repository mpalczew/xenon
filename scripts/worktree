#!/usr/bin/env bash
set -euo pipefail
main="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)"
dir() { printf '%s/.worktrees/%s\n' "$main" "$1"; }

# Each worktree builds into its own target: cargo can't share one between
# checkouts (rust-lang/cargo#12516). Seed it from main's debug build so the
# first build only redoes our own crates. Hard links cost no disk; rustc and
# the linker replace outputs rather than write into them. What is written in
# place is copied instead: rustc's .d files and our own build script's output.
seed() {
    local from="$main/target/debug" to="$1/target/debug"
    mkdir -p "$to"
    touch "$1/target/seeded"
    [[ -d "$from/deps" ]] || return 0
    cp -al "$from/deps" "$from/build" "$to/"
    cp -a "$from/.fingerprint" "$to/"
    cp -p --remove-destination "$from"/deps/*.d "$to/deps/"
    local path
    for path in "$to"/build/xenon*; do
        rm -rf "$path"
        cp -a "$from/build/${path##*/}" "$path"
    done
}

case "${1:-}" in
    new)
        name="${2:?usage: scripts/worktree new NAME}"
        wt="$(dir "$name")"
        git -C "$main" fetch -q origin main
        git -C "$main" worktree add -q -b "wt/$name" "$wt" origin/main
        seed "$wt"
        echo "$wt"
        ;;
    done)
        name="${2:?usage: scripts/worktree done NAME}"
        wt="$(dir "$name")"
        if [[ -n "$(git -C "$wt" status --porcelain)" ]]; then
            echo "$wt has uncommitted changes; not removed" >&2
            exit 1
        fi
        git -C "$main" fetch -q origin main
        if ! git -C "$main" merge-base --is-ancestor "wt/$name" origin/main; then
            echo "wt/$name is not merged into origin/main; not removed" >&2
            exit 1
        fi
        rm -rf "$wt/target"
        git -C "$main" worktree remove "$wt"
        git -C "$main" branch -q -d "wt/$name"
        echo "removed $wt"
        ;;
    list) git -C "$main" worktree list ;;
    *)
        echo "usage: scripts/worktree new NAME | done NAME | list" >&2
        exit 2
        ;;
esac
