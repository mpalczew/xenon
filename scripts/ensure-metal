#!/usr/bin/env bash
# GPUI compiles Metal shaders at build time. Xcode ships the Metal compiler as
# a separate component that Xcode updates drop: fetch it when missing, then
# delete superseded copies (~900 MB each).
set -euo pipefail
[[ "$(uname -s)" == Darwin ]] || exit 0
xcrun metal --version >/dev/null 2>&1 && exit 0

echo "ensure-metal: Metal Toolchain missing; downloading (~900 MB)" >&2
xcodebuild -downloadComponent MetalToolchain >&2
current="$(xcodebuild -showComponent MetalToolchain -json |
    sed -n 's/.*"buildVersion" : "\(.*\)".*/\1/p')"
for plist in /System/Library/AssetsV2/com_apple_MobileAsset_MetalToolchain/*.asset/Info.plist; do
    build="$(plutil -extract MobileAssetProperties.Build raw "$plist" 2>/dev/null)" || continue
    [[ -n "$current" && "$build" != "$current" ]] || continue
    xcodebuild -deleteComponent MetalToolchain -buildVersion "$build" >&2 || true
done
