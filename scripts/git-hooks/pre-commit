#!/usr/bin/env bash
# Checks the staged snapshot in a private tree; never touches the working tree,
# index, or stash. The per-commit gate; scripts/health is the full run (CI).
# Own profile (target/precommit): sharing dogfood with the real tree serves stale
# artifacts, since path crates hash relative to the workspace root.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
work="$root/target/precommit-tree"
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$root/target}"
lock="$root/target/precommit.lock"

mkdir -p "$root/target"
snapshot="$(mktemp -d "${TMPDIR:-/tmp}/xenon-precommit.XXXXXX")"
trap 'rm -rf "$snapshot"' EXIT

until mkdir "$lock" 2>/dev/null; do
    echo "pre-commit: waiting for another commit's checks..." >&2
    sleep 2
done
trap 'rm -rf "$snapshot"; rmdir "$lock"' EXIT

# Honors GIT_INDEX_FILE, so `git commit -- <paths>` checks the real commit content.
staged="$(git diff --cached --name-only)"
git checkout-index -a --prefix="$snapshot/"
mkdir -p "$work"
# Sync by content so unchanged files keep their mtimes and cargo stays incremental.
rsync -a --checksum --delete "$snapshot/" "$work/"

unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX
cd "$work"

run() {
    local name="$1"
    shift
    echo "xenon $name..."
    if ! "$@"; then
        echo "xenon $name: FAILED" >&2
        exit 1
    fi
}

# Crates under crates/<name>/ touched by the commit; root manifest/lock means all.
test_args=()
if grep -qxE 'Cargo\.(toml|lock)' <<<"$staged"; then
    test_args=(--workspace)
else
    while read -r crate; do
        [[ -n "$crate" ]] && test_args+=(-p "$crate")
    done < <(sed -n 's#^crates/\([^/]*\)/.*#\1#p' <<<"$staged" | sort -u)
fi

run public-surface scripts/check-public-surface
run ui-boundaries scripts/check-ui-boundaries
run zed-pins scripts/check-zed-pins
run attribution scripts/check-attribution
run test-determinism scripts/check-test-determinism
run ssh-helper env PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover \
    -s crates/xenon_ssh/src -p helper_test.py
run fmtcheck cargo fmt --all --check
run lint-shape scripts/check-rust-shape
run lint cargo clippy --profile precommit --workspace --all-targets -- \
    -D warnings -D clippy::cognitive_complexity -D clippy::too_many_lines
if ((${#test_args[@]})); then
    run test cargo test --profile precommit "${test_args[@]}"
fi
