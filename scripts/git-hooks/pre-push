#!/usr/bin/env bash
# Stop the line: refuse pushes while CI on main is red.
# Bypass only to push the fix: XENON_CI_FIX=1 git push
root="$(git rev-parse --show-toplevel)"
line="$("$root/scripts/ci-status")"
case "$line" in
green) exit 0 ;;
red*)
    if [[ "${XENON_CI_FIX:-}" == 1 ]]; then
        echo "pre-push: CI is red ($line); XENON_CI_FIX=1 set, pushing the fix." >&2
        exit 0
    fi
    echo "pre-push: CI on main is red: $line" >&2
    echo "Fix it first. To push the fix: XENON_CI_FIX=1 git push" >&2
    exit 1
    ;;
*)
    echo "pre-push: WARNING: could not determine CI state ($line). Pushing anyway." >&2
    exit 0
    ;;
esac
