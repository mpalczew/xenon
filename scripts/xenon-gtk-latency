#!/usr/bin/env -S python3 -I
"""Typing latency of the GTK frontend, measured on the current display.

usage: scripts/xenon-gtk-latency [BINARY] [--keys N] [--seconds S]
                                 [--window WxH | --maximized] [ENV=VALUE ...]

Starts BINARY (default target/dogfood/xenon_gtk) on a private state dir and app id,
injects N keys a second through the `feed-child` D-Bus action (a letter, then a
backspace), and reads the app's own latency log (`XENON_GTK_LATENCY`): the time from
input to `contents-changed`, the time our handler ran, the time to the next frame that
paints the change, and the main thread's CPU while typing. Needs a display that sends
frame callbacks (an unlocked session); on a locked screen no frame is painted and only
the first two numbers are reported. Compare `--window 1000x650` with `--maximized` to see
what window size costs. Only the process it started is closed, by PID.
"""
import json
import os
import re
import shutil
import signal
import statistics
import subprocess
import sys
import tempfile
import time

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def option(name, default=None, flag=False):
    if name in sys.argv:
        i = sys.argv.index(name)
        return True if flag else sys.argv[i + 1]
    return default


binary = next((a for a in sys.argv[1:] if os.path.isfile(a)), f"{ROOT}/target/dogfood/xenon_gtk")
rate = float(option("--keys", 30))
seconds = float(option("--seconds", 6))
window = option("--window")
maximized = option("--maximized", flag=True)
extra_env = dict(a.split("=", 1) for a in sys.argv[1:] if re.fullmatch(r"[A-Z_]+=.*", a))

tmp = tempfile.mkdtemp(prefix="xenon-gtk-latency-")
state = os.path.join(tmp, "state")
shutil.copytree(
    os.path.expanduser("~/.xenon-b"),
    state,
    ignore=shutil.ignore_patterns("ipc.sock", "xenon.pid", "xenon.log"),
    dirs_exist_ok=True,
) if os.path.isdir(os.path.expanduser("~/.xenon-b")) else os.makedirs(state)
settings_path = os.path.join(state, "settings.json")
settings = json.load(open(settings_path)) if os.path.exists(settings_path) else {}
if window:
    w, h = window.split("x")
    settings["window"] = {"x": 0.0, "y": 0.0, "width": float(w), "height": float(h), "state": "windowed"}
elif maximized:
    settings["window"] = {"x": 0.0, "y": 0.0, "width": 1280.0, "height": 1018.0, "state": "maximized"}
json.dump(settings, open(settings_path, "w"))

app_id = f"dev.xenon.GtkLatency{os.getpid()}"
log_path = os.path.join(tmp, "app.log")
env = {**os.environ, "XENON_GTK_APP_ID": app_id, "XENON_GTK_DATA_DIR": state, "XENON_GTK_LATENCY": "1", **extra_env}
proc = subprocess.Popen([binary], env=env, stdout=subprocess.DEVNULL, stderr=open(log_path, "w"), start_new_session=True)


def main_thread_cpu():
    fields = open(f"/proc/{proc.pid}/task/{proc.pid}/stat").read().rsplit(")", 1)[1].split()
    return (int(fields[11]) + int(fields[12])) / os.sysconf("SC_CLK_TCK")


try:
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    group = Gio.DBusActionGroup.get(bus, app_id, "/" + app_id.replace(".", "/"))
    context = GLib.MainContext.default()
    end = time.monotonic() + 20
    while time.monotonic() < end and "feed-child" not in (group.list_actions() or []):
        while context.pending():
            context.iteration(False)
        time.sleep(0.1)
    time.sleep(3)  # the shell starts
    mark = os.path.getsize(log_path)
    cpu0, t0, sent = main_thread_cpu(), time.monotonic(), 0
    while time.monotonic() - t0 < seconds:
        group.activate_action("feed-child", GLib.Variant("s", "a" if sent % 2 == 0 else "\b"))
        bus.flush_sync(None)
        sent += 1
        time.sleep(1.0 / rate)
    cpu1, t1 = main_thread_cpu(), time.monotonic()
    time.sleep(0.5)
    with open(log_path) as f:
        f.seek(mark)
        text = f.read()
    print(re.findall(r"\[lat\] window.*", open(log_path).read()) or "no frame painted (locked screen?)")
    print(f"main thread CPU {(cpu1 - cpu0) / (t1 - t0) * 100:.1f}% at {sent / (t1 - t0):.0f} keys/s")
    for kind, field in (
        ("contents-changed", "since_input"),
        ("contents-changed", "handler"),
        ("frame", "since_input"),
        ("frame", "paint"),
    ):
        values = []
        for m in re.finditer(rf"\[lat\] {kind} .*?{field}=(?:Some\()?([\d.]+)(ns|µs|ms|s)", text):
            values.append(float(m.group(1)) * {"ns": 1e-6, "µs": 1e-3, "ms": 1, "s": 1000}[m.group(2)])
        if values:
            values.sort()
            print(
                f"{kind:17} {field:12} n={len(values):4} median={statistics.median(values):7.2f} ms"
                f"  p90={values[int(len(values) * 0.9)]:7.2f} ms  max={values[-1]:7.2f} ms"
            )
finally:
    if proc.poll() is None:
        os.kill(proc.pid, signal.SIGTERM)
        proc.wait(10)
    shutil.rmtree(tmp, ignore_errors=True)
