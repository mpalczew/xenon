#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
if [[ "$(uname -s)" != Darwin ]]; then
    exec "$root/scripts/release/install-linux" "$@"
fi
# shellcheck source=codesign.sh
source "$root/scripts/release/codesign.sh"

"$root/scripts/release/bundle"
target="${CARGO_TARGET_DIR:-target}"
[[ "$target" == /* ]] || target="$root/$target"

dest_dir="${XENON_INSTALL_DIR:-$HOME/Applications}"
dest="$dest_dir/Xenon.app"
mkdir -p "$dest_dir"
rm -rf "$dest"
cp -R "$target/${XENON_PROFILE:-release}/xenon.app" "$dest"
identity="$(xenon_codesign_identity)"
codesign --force --deep --sign "$identity" --identifier dev.xenon.xenon "$dest" || {
    echo "codesign of installed app failed: $dest" >&2
    exit 1
}
echo "installed $dest (signed: $identity)"

bin_dir="${XENON_BIN_DIR:-$HOME/bin}"
mkdir -p "$bin_dir"
cp "$root/scripts/xenon" "$bin_dir/xenon"
chmod +x "$bin_dir/xenon"
echo "installed $bin_dir/xenon"
