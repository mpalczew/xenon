#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

if [[ "${1:-}" != --force ]]; then
    git -C "$root" fetch -q origin main
    if ! git -C "$root" merge-base --is-ancestor HEAD origin/main; then
        echo "install: commit and push first; HEAD is not on origin/main." >&2
        exit 1
    fi
    status=0
    (cd "$root" && scripts/review-wait) || status=$?
    case $status in
        0) ;;
        3) echo "install: fix the review findings above, push, and rerun." >&2; exit 1 ;;
        *) exit 1 ;;
    esac
fi

(cd "$root" && cargo build -p xenon -p xenon_phone)
target="${CARGO_TARGET_DIR:-target}"
[[ "$target" == /* ]] || target="$root/$target"

data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
app_dir="${XENON_APP_DIR:-$data_home/xenon}"
bin_dir="${XENON_BIN_DIR:-$HOME/.local/bin}"
mkdir -p "$app_dir" "$bin_dir" "$data_home/applications"

# Replace via rename so a running instance keeps its old inode.
for pair in xenon-bin:xenon xenon-term:xenon-term; do
    dest="${pair%%:*}"
    install -m 755 "$target/debug/${pair#*:}" "$app_dir/$dest.new"
    mv -f "$app_dir/$dest.new" "$app_dir/$dest"
    echo "installed $app_dir/$dest"
done

install -m 755 "$root/scripts/xenon" "$bin_dir/xenon"
echo "installed $bin_dir/xenon"
if [[ -d "$HOME/bin" ]]; then
    install -m 755 "$root/scripts/xenon" "$HOME/bin/xenon"
    echo "installed $HOME/bin/xenon"
fi

unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
mkdir -p "$unit_dir"
install -m 644 "$root/scripts/release/xenon-term.slice" "$unit_dir/xenon-term.slice"
install -m 644 "$root/scripts/release/xenon-phone.socket" "$unit_dir/xenon-phone.socket"
sed "s|^ExecStart=.*|ExecStart=$app_dir/xenon-term phone|" "$root/scripts/release/xenon-phone.service" \
    >"$unit_dir/xenon-phone.service"
echo "installed $unit_dir/xenon-term.slice, xenon-phone.socket, xenon-phone.service"
systemctl --user daemon-reload
systemctl --user enable xenon-phone.socket xenon-phone.service
systemctl --user start xenon-phone.socket
if systemctl --user is-active --quiet xenon-phone.service; then
    systemctl --user try-restart xenon-phone.service
    echo "restarted xenon-phone.service"
else
    systemctl --user start xenon-phone.service
    echo "started xenon-phone.service"
fi

rm -f "$data_home/applications/dev.xenon.Gtk.desktop" "$bin_dir/xenon-gtk"
rm -f "$data_home/applications/xenon.desktop" "$data_home"/icons/hicolor/*/apps/xenon.png

# Icon: 512px is the largest size the hicolor theme lists; a bigger one isn't found.
rm -f "$data_home"/icons/hicolor/1024x1024/apps/dev.xenon.Xenon.png \
    "$data_home"/icons/hicolor/*/apps/xenon-gtk.png
install -D -m 644 "$root/assets/xenon-icon-512.png" \
    "$data_home/icons/hicolor/512x512/apps/dev.xenon.Xenon.png"

cat >"$data_home/applications/dev.xenon.Xenon.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Xenon
Comment=Agent shell for driving coding agents
Exec=$bin_dir/xenon %F
Icon=dev.xenon.Xenon
Terminal=false
Categories=Development;TerminalEmulator;
StartupWMClass=dev.xenon.Xenon
DESKTOP
echo "installed $data_home/applications/dev.xenon.Xenon.desktop"

command -v update-desktop-database >/dev/null 2>&1 &&
    update-desktop-database "$data_home/applications" 2>/dev/null || true
command -v gtk-update-icon-cache >/dev/null 2>&1 &&
    gtk-update-icon-cache -q -t "$data_home/icons/hicolor" 2>/dev/null || true
# KDE: rebuild the menu cache and drop KIconLoader's stale icon cache so Plasma
# shows the icon without a restart.
if command -v kbuildsycoca6 >/dev/null 2>&1; then
    kbuildsycoca6 --noincremental >/dev/null 2>&1 || true
    rm -f "${XDG_CACHE_HOME:-$HOME/.cache}/icon-cache.kcache"
elif command -v kbuildsycoca5 >/dev/null 2>&1; then
    kbuildsycoca5 --noincremental >/dev/null 2>&1 || true
    rm -f "${XDG_CACHE_HOME:-$HOME/.cache}/icon-cache.kcache"
fi
case ":$PATH:" in
    *":$bin_dir:"*) ;;
    *) echo "note: $bin_dir is not on PATH" >&2 ;;
esac

"$root/scripts/prune-target"

dirty=$(git -C "$root" status --short)
if [[ -n "$dirty" ]]; then
    printf 'Uncommitted paths; tell the user whose they are:\n%s\n' "$dirty"
fi
