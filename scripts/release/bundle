#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck source=codesign.sh
source "$root/scripts/release/codesign.sh"

# XENON_PROFILE=dogfood is the author's incremental local profile (project install).
profile="${XENON_PROFILE:-release}"
(cd "$root" && cargo build --profile "$profile" -p xenon -p xenon_stub)

# Harnesses build in worktrees with a shared CARGO_TARGET_DIR; cargo resolves it from $root.
target="${CARGO_TARGET_DIR:-target}"
[[ "$target" == /* ]] || target="$root/$target"
app="$target/$profile/xenon.app"
identity="$(xenon_codesign_identity)"
rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp "$root/macos/Info.plist" "$app/Contents/Info.plist"
cp "$root/macos/xenon.icns" "$app/Contents/Resources/xenon.icns"
# Dock/Launch Services run the stub; the GUI is xenon-bin beside it.
cp "$target/$profile/xenon-stub" "$app/Contents/MacOS/xenon"
cp "$target/$profile/xenon" "$app/Contents/MacOS/xenon-bin"
# Same identifier on stub and xenon-bin so FDA/TCC survive exec of the GUI.
codesign --force --deep --sign "$identity" --identifier dev.xenon.xenon "$app" || {
    echo "codesign failed with identity: $identity" >&2
    exit 1
}
echo "bundled $app (signed: $identity)"
