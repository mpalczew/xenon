#!/usr/bin/env bash
# Install the GTK frontend beside the GPUI app, touching nothing of it.
#   ~/.local/share/xenon-gtk/xenon-gtk-bin     GUI binary
#   ~/.local/bin/xenon-gtk                     launcher (scripts/xenon-gtk)
#   ~/.local/share/applications/dev.xenon.Gtk.desktop   "Xenon (GTK)"
#   ~/.xenon-gtk                               state (created on first run,
#                                              seeded from the GPUI app)
# Own app id (dev.xenon.Gtk), so both apps run at once. Does not modify
# scripts/xenon, ~/bin/xenon, ~/.local/bin/xenon, or scripts/release/install.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
profile="${XENON_PROFILE:-dogfood}"

(cd "$root" && cargo build --profile "$profile" -p xenon_gtk)
target="${CARGO_TARGET_DIR:-target}"
[[ "$target" == /* ]] || target="$root/$target"

data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
app_dir="${XENON_GTK_APP_DIR:-$data_home/xenon-gtk}"
bin_dir="${XENON_GTK_BIN_DIR:-$HOME/.local/bin}"
mkdir -p "$app_dir" "$bin_dir" "$data_home/applications"

# Replace via rename so a running instance keeps its old inode.
install -m 755 "$target/$profile/xenon_gtk" "$app_dir/xenon-gtk-bin.new"
mv -f "$app_dir/xenon-gtk-bin.new" "$app_dir/xenon-gtk-bin"
echo "installed $app_dir/xenon-gtk-bin"

install -m 755 "$root/scripts/xenon-gtk" "$bin_dir/xenon-gtk"
echo "installed $bin_dir/xenon-gtk"

# Same icon as the GPUI app, under its own name.
icon_src="$root/assets/xenon-icon-source.png"
icon_dir="$data_home/icons/hicolor/512x512/apps"
mkdir -p "$icon_dir"
if resize="$(command -v magick || command -v convert)"; then
    "$resize" "$icon_src" -resize 512x512 "$icon_dir/xenon-gtk.png"
else
    cp "$icon_src" "$icon_dir/xenon-gtk.png"
fi

# The file name is the app id, which is how GNOME ties the window to the entry.
cat >"$data_home/applications/dev.xenon.Gtk.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Xenon (GTK)
Comment=Agent shell for driving coding agents (GTK frontend)
Exec=$bin_dir/xenon-gtk %F
Icon=$icon_dir/xenon-gtk.png
Terminal=false
Categories=Development;TerminalEmulator;
StartupWMClass=dev.xenon.Gtk
DESKTOP
echo "installed $data_home/applications/dev.xenon.Gtk.desktop"

command -v update-desktop-database >/dev/null 2>&1 &&
    update-desktop-database "$data_home/applications" 2>/dev/null || true
command -v gtk-update-icon-cache >/dev/null 2>&1 &&
    gtk-update-icon-cache -q -t "$data_home/icons/hicolor" 2>/dev/null || true
case ":$PATH:" in
    *":$bin_dir:"*) ;;
    *) echo "note: $bin_dir is not on PATH" >&2 ;;
esac
echo "first run seeds ~/.xenon-gtk from the GPUI app's last slot; \`xenon-gtk --reseed\` seeds again"
