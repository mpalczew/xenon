# Holds every Xenon terminal, so the window can restart without ending agents.
# Stopping this service ends the terminals: the default KillMode (control-group) hangs
# up every shell and agent still in its cgroup, so nothing is left behind. The socket
# starts a fresh service on the next connect. Install never restarts it; upgrade by hand.
[Unit]
Description=Xenon terminal service
Requires=xenon-term.socket
After=xenon-term.socket

[Service]
Type=simple
ExecStart=%h/.local/share/xenon/xenon-term
Restart=no
