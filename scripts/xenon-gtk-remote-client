#!/usr/bin/env -S python3 -I
"""A phone, in Python: the test client for the Xenon phone remote.

Speaks the same protocol as the page the server serves (crates/xenon_remote):
POST /pair, bearer-token REST lists, and the /ws WebSocket (hello, attach, text,
key, fit, frames). Standard library only. scripts/xenon-gtk-verify and
scripts/xenon-gtk-idle load this file; run directly it pairs, lists, attaches to
the first terminal, types a command and prints the screen:

    scripts/xenon-gtk-remote-client PORT [TOKEN | --code CODE]
"""
import base64
import hashlib
import http.client
import json
import os
import socket
import struct
import sys
import time


class PhoneClient:
    def __init__(self, port, token=None, host="127.0.0.1"):
        self.host, self.port, self.token = host, port, token
        self.sock = None
        self.buf = b""
        self.styles = {}
        self.rows = {}
        self.cols = self.nrows = 0
        self.cursor = None
        self.scrolled = False
        self.theme = None
        self.dots = None
        self.frames = 0
        self.closed = None

    # REST -----------------------------------------------------------------
    def _http(self, method, path, body=None, auth=True):
        conn = http.client.HTTPConnection(self.host, self.port, timeout=10)
        headers = {"Content-Type": "application/json"}
        if auth and self.token:
            headers["Authorization"] = f"Bearer {self.token}"
        conn.request(method, path, json.dumps(body) if body is not None else None, headers)
        resp = conn.getresponse()
        data = resp.read()
        conn.close()
        try:
            return resp.status, json.loads(data)
        except ValueError:
            return resp.status, data

    def pair(self, code, label="Test phone"):
        status, body = self._http("POST", "/pair", {"code": code, "label": label}, auth=False)
        if status != 200:
            raise RuntimeError(f"pair failed: {status} {body}")
        self.token = body["token"]
        return body

    def workspaces(self):
        return self._http("GET", "/api/workspaces")[1]

    def terminals(self, workspace_id):
        status, body = self._http("GET", f"/api/workspaces/{workspace_id}/terminals")
        if status != 200:
            raise RuntimeError(f"terminals: {status} {body}")
        return body

    def new_terminal(self, workspace_id):
        return self._http("POST", f"/api/workspaces/{workspace_id}/terminals")[1]

    # WebSocket ------------------------------------------------------------
    def connect(self):
        self.sock = socket.create_connection((self.host, self.port), timeout=10)
        key = base64.b64encode(os.urandom(16)).decode()
        self.sock.sendall(
            (
                f"GET /ws HTTP/1.1\r\nHost: {self.host}:{self.port}\r\n"
                f"Origin: http://{self.host}:{self.port}\r\n"
                "Upgrade: websocket\r\nConnection: Upgrade\r\n"
                f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n"
            ).encode()
        )
        head = b""
        while b"\r\n\r\n" not in head:
            chunk = self.sock.recv(4096)
            if not chunk:
                raise RuntimeError("websocket closed during handshake")
            head += chunk
        head, _, self.buf = head.partition(b"\r\n\r\n")
        if b" 101 " not in head.split(b"\r\n")[0]:
            raise RuntimeError(f"websocket refused: {head[:80]!r}")
        accept = base64.b64encode(
            hashlib.sha1((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()).digest()
        ).decode()
        if accept.encode() not in head:
            raise RuntimeError("bad websocket accept")
        self.send({"t": "hello", "token": self.token})
        return self.until(lambda m: m["t"] == "ready", 10)

    def send(self, msg):
        payload = json.dumps(msg).encode()
        mask = os.urandom(4)
        n = len(payload)
        head = b"\x81" + (bytes([0x80 | n]) if n < 126 else b"\xfe" + struct.pack(">H", n))
        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        self.sock.sendall(head + mask + masked)

    def _read(self, n, deadline):
        while len(self.buf) < n:
            left = deadline - time.monotonic()
            if left <= 0:
                raise TimeoutError
            self.sock.settimeout(left)
            try:
                chunk = self.sock.recv(65536)
            except socket.timeout:
                raise TimeoutError
            if not chunk:
                raise ConnectionError("websocket closed")
            self.buf += chunk
        out, self.buf = self.buf[:n], self.buf[n:]
        return out

    def recv(self, timeout=5.0):
        """The next server message (None for a close frame); applies it to the screen."""
        deadline = time.monotonic() + timeout
        while True:
            b0, b1 = self._read(2, deadline)
            n = b1 & 0x7F
            if n == 126:
                n = struct.unpack(">H", self._read(2, deadline))[0]
            elif n == 127:
                n = struct.unpack(">Q", self._read(8, deadline))[0]
            data = self._read(n, deadline)
            op = b0 & 0x0F
            if op == 8:
                self.closed = data[:2]
                return None
            if op != 1:
                continue
            msg = json.loads(data)
            self.apply(msg)
            return msg

    def until(self, pred, timeout=5.0):
        deadline = time.monotonic() + timeout
        while True:
            msg = self.recv(max(0.05, deadline - time.monotonic()))
            if msg is None:
                raise ConnectionError("websocket closed")
            if pred(msg):
                return msg

    def apply(self, msg):
        kind = msg["t"]
        if kind == "styles":
            self.styles.update({int(k): v for k, v in msg["add"].items()})
        elif kind == "frame":
            self.frames += 1
            if msg["full"] or msg["rows"] != self.nrows or msg["cols"] != self.cols:
                self.rows = {}
            self.cols, self.nrows = msg["cols"], msg["rows"]
            for index, spans in msg["lines"]:
                self.rows[index] = spans
            self.cursor = msg.get("cursor")
            self.scrolled = msg.get("scrolled", False)
        elif kind == "theme":
            self.theme = msg["theme"]
        elif kind == "ready":
            self.theme = msg["theme"]
        elif kind == "dots":
            self.dots = msg

    def screen(self):
        """Row texts of the current screen."""
        return ["".join(t for t, _ in self.rows.get(i, [])).rstrip() for i in range(self.nrows)]

    def text(self):
        return "\n".join(self.screen())

    def style_at(self, row, col):
        """Style (dict) of the cell at row, col."""
        at = 0
        for text, style in self.rows.get(row, []):
            if at + len(text) > col:
                return self.styles.get(style, {})
            at += len(text)
        return {}

    def wait_text(self, needle, timeout=8.0):
        deadline = time.monotonic() + timeout
        while needle not in self.text():
            left = deadline - time.monotonic()
            if left <= 0:
                raise TimeoutError(f"{needle!r} not on the phone's screen:\n{self.text()}")
            try:
                if self.recv(left) is None:
                    raise ConnectionError("websocket closed")
            except TimeoutError:
                continue

    def drain(self, quiet=0.5):
        """Read messages until none arrives for `quiet` seconds; returns how many."""
        n = 0
        while True:
            try:
                if self.recv(quiet) is None:
                    return n
                n += 1
            except TimeoutError:
                return n

    def close(self):
        if self.sock:
            try:
                self.sock.close()
            except OSError:
                pass
            self.sock = None


def main(argv):
    port = int(argv[0])
    phone = PhoneClient(port)
    if len(argv) > 2 and argv[1] == "--code":
        phone.pair(argv[2])
        print("paired; token", phone.token)
    else:
        phone.token = argv[1]
    for ws in phone.workspaces():
        print("workspace", ws)
    ws = next(w for w in phone.workspaces() if w["open"])
    tab = phone.terminals(ws["id"])[0]
    phone.connect()
    phone.send({"t": "attach", "workspaceId": ws["id"], "tabId": tab["tabId"]})
    phone.send({"t": "text", "data": "echo hello-from-phone\n"})
    phone.wait_text("hello-from-phone")
    print(phone.text())


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
