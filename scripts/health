#!/usr/bin/env bash
# Full run (manual, CI). The pre-commit hook is the per-commit gate.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
scripts/check-public-surface
scripts/check-ui-boundaries
scripts/check-zed-pins
scripts/check-attribution
scripts/check-test-determinism
PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s crates/xenon_ssh/src -p helper_test.py
cargo fmt --all --check
cargo clippy --profile dogfood --workspace --all-targets -- -D warnings \
    -D clippy::cognitive_complexity \
    -D clippy::too_many_lines
scripts/check-rust-shape
cargo test --profile dogfood
