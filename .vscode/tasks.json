// Only the `xenon` and `install` tasks. Build, format and lint run through cargo
// or scripts/; don't add more tasks here.
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "xenon",
      "type": "shell",
      "command": "~/bin/xenon",
      "detail": "launch Xenon via the slot launcher",
      "presentation": {
        "close": true
      }
    },
    {
      "label": "install",
      "type": "shell",
      "command": "scripts/release/install",
      "detail": "build the GTK app and install it with the slot launcher into ~/.local and ~/bin"
    }
  ]
}
