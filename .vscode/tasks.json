{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "xenon",
      "type": "shell",
      "command": "~/bin/xenon",
      "linux": {
        "command": "~/.local/bin/xenon"
      },
      "detail": "launch Xenon via the slot launcher"
    },
    {
      "label": "xenon-gtk",
      "type": "shell",
      "command": "~/.local/bin/xenon-gtk",
      "detail": "launch the GTK frontend (own state in ~/.xenon-gtk)"
    },
    {
      "label": "install-gtk",
      "type": "shell",
      "command": "scripts/release/install-gtk",
      "detail": "build and install xenon-gtk into ~/.local"
    },
    {
      "label": "install",
      "type": "shell",
      "command": "bin/install",
      "detail": "bundle Xenon.app into ~/Applications and install ~/bin/xenon"
    }
  ]
}
