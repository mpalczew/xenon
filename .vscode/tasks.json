{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "xenon",
      "type": "shell",
      "command": "~/bin/xenon",
      "detail": "launch Xenon via the slot launcher (alias: ~/bin/xero)"
    },
    {
      "label": "install",
      "type": "shell",
      "command": "XENON_PROFILE=dogfood scripts/release/install && scripts/prune-target",
      "detail": "bundle Xenon.app into ~/Applications and install ~/bin/xenon"
    }
  ]
}
