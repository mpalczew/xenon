#!/usr/bin/env bash
# Silent on pass, output only on failure. Reuses the gates of scripts/health.
#   bin/check          gates whose paths changed vs main (working tree included)
#   bin/check <gate>   one gate: policy | rust | harness | dprint
#   bin/check all      every gate
#   bin/check --staged pre-commit: harness only (reads the index); the hook checks the
#                      other gates in a snapshot of the index (scripts/git-hooks/pre-commit)
set -uo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

step() {
  local gate="$1" name="$2" log rc=0
  shift 2
  log="$(mktemp)"
  "$@" >"$log" 2>&1 || rc=$?
  if [ "$rc" -eq 0 ]; then
    echo "✓ $gate: $name"
    rm -f "$log"
  else
    cat "$log"
    echo "✗ $gate: $name" >&2
    rm -f "$log"
    exit 1
  fi
}

check_harness() {
  local bad
  bad="$(git ls-files .claude | rg -vx '\.claude/skills' || true)"
  if [ -e .claude/skills ] || [ -L .claude/skills ]; then
    if [ ! -L .claude/skills ] || [ "$(readlink .claude/skills)" != "../.agents/skills" ]; then
      bad="$bad"$'\n'".claude/skills"
    fi
  fi
  bad="$(printf '%s\n' "$bad" | sed '/^$/d')"
  [ -z "$bad" ] || { printf '%s\n' "$bad"; return 1; }
}

gate_harness() {
  step harness ".claude holds only the skills link" check_harness
}

gate_policy() {
  step policy public-surface scripts/check-public-surface
  step policy attribution scripts/check-attribution
}

gate_dprint() {
  step dprint check dprint check
}

gate_rust() {
  step rust fmt cargo fmt --all --check
  step rust shape scripts/check-rust-shape
  step rust clippy cargo clippy --workspace --all-targets -- -D warnings \
    -D clippy::cognitive_complexity -D clippy::too_many_lines
}

if [ "${1:-}" = --staged ]; then
  gate_harness
  exit 0
fi

changed="$( { git diff --name-only main; git ls-files --others --exclude-standard; } 2>/dev/null | sort -u)"

case "${1:-}" in
all) gates=(harness policy dprint rust) ; changed="" ;;
policy | rust | harness | dprint) gates=("$1") ;;
"")
  gates=(harness)
  [ -n "$changed" ] && gates+=(policy)
  rg -q '\.(md|mdc|json|jsonc)$' <<<"$changed" && gates+=(dprint)
  rg -q '^(crates/|Cargo\.|rust-toolchain|rustfmt\.toml|clippy\.toml|scripts/(check-rust-shape|rust-shape))' <<<"$changed" && gates+=(rust)
  ;;
*) echo "usage: bin/check [policy|rust|harness|dprint|all]" >&2; exit 2 ;;
esac

for g in "${gates[@]}"; do "gate_$g"; done
