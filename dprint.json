{
  "markdown": {
    "lineWidth": 88,
    "textWrap": "always",
    "emphasisKind": "asterisks",
    "strongKind": "asterisks",
    "newLineKind": "lf"
  },
  "json": { "indentWidth": 2, "lineWidth": 100 },
  "includes": ["**/*.{md,mdc,json,jsonc}"],
  "excludes": [
    "**/node_modules",
    "**/target",
    "**/third_party",
    "**/build",
    "**/dist",
    "**/*.min.*",
    "**/package-lock.json",
    "**/Cargo.toml",
    "**/Cargo.lock"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.22.1.wasm",
    "npm:@dprint/json@0.25.2"
  ]
}
