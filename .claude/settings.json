{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"CI status of main: $(scripts/ci-status 2>&1 || true)\"; exit 0",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && out=$(bin/check 2>&1) || { echo \"$out\" >&2; exit 2; }",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
